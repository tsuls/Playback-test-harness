{
  "name": "playback-test-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Automated video playback tests in TypeScript with Playwright and Shaka Player: time to first frame, rebuffering, errors, flake detection, and CI on every push.",
  "license": "MIT",
  "author": "Tyler Sulsenti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuls/Playback-test-harness.git"
  },
  "bugs": {
    "url": "https://github.com/tsuls/Playback-test-harness/issues"
  },
  "homepage": "https://github.com/tsuls/Playback-test-harness#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsc && playwright test",
    "test:unit": "playwright test --project=unit",
    "test:chaos": "CHAOS=1 playwright test tests/chaos.spec.ts --repeat-each=10",
    "report": "tsx scripts/flake-report.ts && tsx scripts/metrics-report.ts && tsx scripts/experiment-report.ts",
    "experiment": "playwright test --grep @experiment --repeat-each=10 && tsx scripts/experiment-report.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "shaka-player": "^5.2.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": []
}
